# QuishGuard Environment Variables
# Copy this file to .env and fill in your values

# Google Generative AI API Key (FREE - required for fraud analysis)
# Get from: https://aistudio.google.com/app/apikeys (free tier, no billing needed)
GOOGLE_API_KEY=your-api-key-here

# Backend configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend configuration  
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=3000
REACT_APP_API_URL=http://localhost:8000
